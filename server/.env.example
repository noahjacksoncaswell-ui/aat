# PostgreSQL connection (docker-compose defaults shown)
DATABASE_URL="postgresql://aat:aat_dev_password@localhost:5432/aat_lod?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Object storage (S3-compatible). If left unset, the server falls back to
# local-disk storage under server/uploads for local development.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="aat-lod-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Weather providers
# NOAA/NWS requires no key and is used automatically for sites inside the US.
NWS_USER_AGENT="AAT-LOD-Platform (ops@aat-aerospace.example)"
# Optional fallback / non-US sites
OPENWEATHERMAP_API_KEY=""

# Mail (forgot-password flow) - dev default logs to console if unset
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AAT LOD Platform <ops@aat-aerospace.example>"

APP_BASE_URL="http://localhost:5173"
